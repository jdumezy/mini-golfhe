---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NerdPanel from "../components/NerdPanel.astro";

const button =
  "h-9 rounded-md px-4 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-400 disabled:cursor-not-allowed disabled:opacity-50";
---

<Layout title="mini-golfhe" description="An 18-hole mini golf whose physics runs under fully homomorphic encryption.">
  <Header />
  <main class="flex flex-1 flex-col items-center px-4 pb-4">
    <div class="flex w-full max-w-5xl items-baseline justify-between gap-4 font-mono text-sm">
      <p><span id="hole-title" class="font-semibold">–</span> <span id="hole-name" class="text-zinc-500"></span></p>
      <p id="hole-strokes" class="text-zinc-500"></p>
    </div>
    <div id="course" class="relative mt-2 h-[min(36rem,calc(100dvh-20rem))] min-h-72 w-full max-w-5xl select-none"></div>
    <div class="mt-2 flex items-center gap-3">
      <div class="flex items-center gap-2 font-mono text-xs text-zinc-500">
        <span>power</span>
        <div class="h-1.5 w-32 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
          <div id="power-bar" class="h-full w-0 rounded-full"></div>
        </div>
        <span id="power-value" class="w-9 text-right">–</span>
      </div>
      <button
        id="shoot"
        type="button"
        class={`${button} bg-emerald-600 text-white hover:bg-emerald-500`}
      >
        Shoot
      </button>
      <button
        id="next"
        type="button"
        class={`${button} bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300`}
        hidden
      >
        Next hole
      </button>
      <button
        id="new-round"
        type="button"
        class={`${button} border border-zinc-300 text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-900`}
      >
        New round
      </button>
    </div>
    <p id="status" class="mt-3 h-4 font-mono text-xs text-zinc-500" aria-live="polite"></p>
    <div
      id="progress"
      class="mt-2 h-1.5 w-64 max-w-full overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"
      role="progressbar"
      aria-label="Simulation progress"
      aria-valuemin="0"
      aria-valuemax="100"
      hidden
    >
      <div id="progress-bar" class="h-full w-0 rounded-full bg-emerald-500 transition-[width] duration-300"></div>
    </div>
    <div class="mt-3 w-full max-w-5xl overflow-x-auto">
      <table id="scorecard" class="mx-auto border-collapse font-mono text-xs tabular-nums"></table>
    </div>
    <p class="mt-3 hidden text-center text-xs text-zinc-400 sm:block dark:text-zinc-600">
      drag back from the ball to aim, release to shoot · drag elsewhere to turn the view, right-drag or shift-drag to move it, scroll to zoom · keys{" "}
      <kbd class="font-mono">← →</kbd> aim (<kbd class="font-mono">shift</kbd> finer), <kbd class="font-mono">↑ ↓</kbd>
      power, <kbd class="font-mono">W A S D</kbd> move, <kbd class="font-mono">space</kbd> shoot, <kbd class="font-mono">enter</kbd> next hole
    </p>
  </main>
  <Footer />
  <NerdPanel />
</Layout>

<script>
  import "../scripts/app";
</script>
