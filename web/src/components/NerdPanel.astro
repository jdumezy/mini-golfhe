---
const section = "border-t border-zinc-200 px-4 py-3 dark:border-zinc-800";
const heading = "mb-2 text-[0.65rem] uppercase tracking-widest text-zinc-400 dark:text-zinc-500";
const row = "flex justify-between gap-4 py-0.5";
const label = "text-zinc-500";
const block = "mt-1 break-all rounded bg-zinc-100 px-2 py-1.5 leading-relaxed dark:bg-zinc-950";
---

<aside
  id="nerd-panel"
  class="fixed inset-y-0 right-0 z-20 flex w-full translate-x-full flex-col border-l border-zinc-200 bg-white/95 font-mono text-xs shadow-xl backdrop-blur transition-transform duration-200 data-open:translate-x-0 sm:w-96 dark:border-zinc-800 dark:bg-zinc-900/95"
  aria-label="Stats for nerds"
  inert
>
  <div class="flex items-center justify-between px-4 py-3">
    <span class="font-semibold">stats for nerds</span>
    <button
      id="nerd-close"
      type="button"
      class="rounded px-2 py-1 text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
      aria-label="Close"
    >
      ✕
    </button>
  </div>

  <div class="flex-1 overflow-y-auto pb-6">
    <section class={section}>
      <h2 class={heading}>render</h2>
      <div class={row}><span class={label}>fps</span><span data-stat="fps">–</span></div>
      <div class={row}><span class={label}>draw calls</span><span data-stat="drawCalls">–</span></div>
      <div class={row}><span class={label}>triangles</span><span data-stat="triangles">–</span></div>
      <div class={row}><span class={label}>pixel ratio</span><span data-stat="pixelRatio">–</span></div>
    </section>

    <section class={section}>
      <h2 class={heading}>hole</h2>
      <div class={row}><span class={label}>hole / par</span><span data-stat="hole">–</span></div>
      <div class={row}><span class={label}>rails / blocks / bumpers</span><span data-stat="obstacles">–</span></div>
      <div class={row}><span class={label}>contact faces</span><span data-stat="faces">–</span></div>
      <div class={row}><span class={label}>ponds</span><span data-stat="ponds">–</span></div>
      <div class={`${label} mt-2`}>terrain h = ½ dᵀHd + s·d, d = q − c</div>
      <div class={block} data-stat="terrain">–</div>
    </section>

    <section class={section}>
      <h2 class={heading}>physics</h2>
      <div class={row}><span class={label}>model</span><span>rolling, linear drag</span></div>
      <div class={row}><span class={label}>drag λ / roll g</span><span data-stat="drag">–</span></div>
      <div class={row}><span class={label}>grid dt × steps</span><span data-stat="grid">–</span></div>
      <div class={row}><span class={label}>contacts per shot</span><span data-stat="maxContacts">–</span></div>
      <div class={row}><span class={label}>contact tests / segment</span><span data-stat="tests">–</span></div>
    </section>

    <section class={section}>
      <h2 class={heading}>last shot</h2>
      <div class={row}><span class={label}>angle / power</span><span data-stat="shotAim">–</span></div>
      <div class={row}><span class={label}>playback</span><span data-stat="shotPlayback">–</span></div>
      <div class={row}><span class={label}>contacts / exhausted</span><span data-stat="shotContacts">–</span></div>
      <div class={row}><span class={label}>duration / samples</span><span data-stat="shotDuration">–</span></div>
      <div class={row}><span class={label}>outcome</span><span data-stat="shotOutcome">–</span></div>
      <div class={`${label} mt-2`}>segments (t: x y vx vy)</div>
      <div class={block} data-stat="segments">–</div>
    </section>

    <section class={section}>
      <h2 class={heading}>fhe</h2>
      <div class={row}><span class={label}>scheme</span><span data-stat="fheScheme">–</span></div>
      <div class={row}><span class={label}>evaluation backend</span><span data-stat="fheBackend">–</span></div>
      <div class={row}><span class={label}>client backend</span><span data-stat="fheClientBackend">–</span></div>
      <div class={row}><span class={label}>client</span><span data-stat="fheClient">–</span></div>
      <div class={row}><span class={label}>server</span><span data-stat="fheServer">–</span></div>
      <div class={row}><span class={label}>circuit</span><span data-stat="fheCircuit">–</span></div>
      <div class={row}><span class={label}>max modulus (keys / ciphertexts)</span><span data-stat="fheModulus">–</span></div>
      <div class={row}><span class={label}>128-bit bound</span><span data-stat="fheBound">–</span></div>
      <div class={row}><span class={label}>sparse key / bound</span><span data-stat="fheSparse">–</span></div>
      <div class={row}><span class={label}>evaluation keys</span><span data-stat="fheKey">–</span></div>
      <div class={row}><span class={label}>keygen / server prepare</span><span data-stat="fheKeyTimes">–</span></div>
      <div class={`${label} mt-2`}>last shot</div>
      <div class={row}><span class={label}>shot / contact ciphertexts</span><span data-stat="fheCiphertexts">–</span></div>
      <div class={row}><span class={label}>encrypt</span><span data-stat="fheEncrypt">–</span></div>
      <div class={row}><span class={label}>simulate (server)</span><span data-stat="fheSimulate">–</span></div>
      <div class={row}><span class={label}>bootstraps</span><span data-stat="fheRefresh">–</span></div>
      <div class={row}><span class={label}>decrypt</span><span data-stat="fheDecrypt">–</span></div>
      <div class={row}><span class={label}>transport / total</span><span data-stat="fheTotal">–</span></div>
      <div class={row}><span class={label}>contacts / slots</span><span data-stat="fheContacts">–</span></div>
      <div class={`${label} mt-2`}>contact weights (decrypted)</div>
      <div class={block} data-stat="fheConfidence">–</div>
    </section>
  </div>
</aside>
